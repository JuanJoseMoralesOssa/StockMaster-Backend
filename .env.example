# Use sslmode=verify-full in PostgreSQL URLs to avoid pg SSL mode warnings.
# Example: postgresql://user:password@host:5432/database?sslmode=verify-full
BD_URL=
BD_HOST=
BD_USER=
BD_PASSWORD=
BD_PORT=
BD_DATABASE=

# Secreto fuerte y único (obligatorio en producción). Generar p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Expiración del token de acceso (default 1d). Ej: 12h, 1d.
JWT_EXPIRATION=1d

# La cookie de sesión (auth_token) es Secure automáticamente cuando
# NODE_ENV=production. En dev/test normalmente se deja vacío (HTTP local);
# poné COOKIE_SECURE=true solo para probar sobre HTTPS local o detrás de un
# proxy antes de que NODE_ENV pase a production.
COOKIE_SECURE=

# CORS: orígenes del frontend permitidos (coma-separado). Ej en prod:
#   https://mi-frontend.com
# En dev, si se omite, se permiten http://localhost:5173 y http://127.0.0.1:5173
FRONTEND_ORIGIN=

# Form-scan extraction endpoint (POST /purchases/extract)
# Vision provider: "chain" uses Gemini first, then provider fallbacks.
# For diagnostics you can still force one provider: gemini, ollama, groq, ocrspace.
FORM_VISION_PROVIDER=chain
FORM_VISION_PROVIDER_CHAIN=gemini,ollama,groq,ocrspace
GEMINI_API_KEY=
# Optional: override the Gemini vision model (default: gemini-3.5-flash)
GEMINI_VISION_MODEL=
# Optional: comma-separated fallback chain used for retryable Gemini failures.
GEMINI_VISION_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-flash,gemma-4-31b-it,gemma-4-26b-a4b-it
# Optional: override Gemini media resolution for generateContent.
# Default keeps OCR accuracy for receipts/forms.
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
# Operational timeouts, calibrated from backend logs, not fixed by Gemini docs.
# Per-model timeout controls when to try the next fallback model.
GEMINI_TIMEOUT_MS=8000
# Total budget for one extraction request across the full model chain.
GEMINI_TOTAL_TIMEOUT_MS=26000
# Overall endpoint guard. Per-model Gemini limits are enforced by the provider:
# 3.5 Flash 5/20, 3 Flash 5/20, 3.1 Flash-Lite 15/500,
# 2.5 Flash-Lite 10/20, 2.5 Flash 5/20.
GEMINI_EXTRACT_RPM_LIMIT=50
GEMINI_EXTRACT_RPD_LIMIT=618

# --- Groq vision fallback (or force with FORM_VISION_PROVIDER=groq) ---
# Only Groq's MULTIMODAL models read images. The flagship text models
# (llama-3.3-70b-versatile, llama-3.1-8b-instant) do NOT accept images.
# qwen/qwen3.6-27b is the durable multimodal default; llama-4-scout also works
# but shuts down 2026-07-17 (kept only as a short-lived fallback — remove after).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=8000
GROQ_TOTAL_TIMEOUT_MS=26000

# --- Ollama Cloud vision fallback (or force with FORM_VISION_PROVIDER=ollama) ---
# Requires OLLAMA_API_KEY. Check Cloud availability with
# https://ollama.com/api/tags and use an available multimodal model.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_VISION_FALLBACK_MODELS=llama3.2-vision,moondream
OLLAMA_TIMEOUT_MS=15000
OLLAMA_TOTAL_TIMEOUT_MS=45000
OLLAMA_MAX_OUTPUT_TOKENS=2048
OLLAMA_TEMPERATURE=0.1

# --- OCR.space OCR fallback (or force with FORM_VISION_PROVIDER=ocrspace) ---
# External OCR-only fallback: images leave the server, and the backend maps the
# returned text to form fields. Free API limits can change; verify current terms.
OCRSPACE_API_KEY=
OCRSPACE_BASE_URL=https://api.ocr.space/parse/image
OCRSPACE_LANGUAGE=spa
OCRSPACE_ENGINE=2
OCRSPACE_TIMEOUT_MS=15000

# ==================================================
# Privacy mode for future thesis/text AI providers
# ==================================================
# These settings document the privacy posture expected by any text-generation
# provider chain added to the app. They are intentionally separate from the
# form-scan vision provider above.
PRIVACY_MODE=strict
ALLOW_PROVIDERS_THAT_TRAIN_ON_PROMPTS=false
ALLOW_PROMPT_RETENTION=false
ALLOW_ABUSE_LOG_CONTENT=false
ALLOW_ROUTER_DOWNSTREAM_TRAINING=false

# Provider order for private thesis/text workloads. OCR.space is vision-only.
TEXT_THESIS_PROVIDER_ORDER=gemini,ollama_cloud,groq_zdr,cerebras,cloudflare,vercel_gateway,openrouter

# Keep non-ideal providers disabled unless explicitly accepted for this workload.
GEMINI_ENABLED=true
MISTRAL_ENABLED=false
HUGGINGFACE_ENABLED=false

# Enable Gemini for text only after confirming paid/no-training/no-retention terms.
GEMINI_PAID_ALLOWED=true
MISTRAL_SCALE_ALLOWED=false

# ==================================================
# Ollama Cloud - primary privacy-friendly text provider
# ==================================================
OLLAMA_CLOUD_ENABLED=true
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_TEXT_MODEL=qwen3.6:27b
OLLAMA_CLOUD_TEXT_FALLBACK_MODELS=qwen3.6:35b-a3b,gpt-oss:20b
OLLAMA_CLOUD_TIMEOUT_SECONDS=45
OLLAMA_CLOUD_MAX_OUTPUT_TOKENS=800
OLLAMA_CLOUD_TEMPERATURE=0.2

# ==================================================
# Vercel AI Gateway - governance/routing text layer
# ==================================================
VERCEL_AI_GATEWAY_ENABLED=true
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_REQUIRE_ZERO_DATA_RETENTION=true
VERCEL_DISALLOW_PROMPT_TRAINING=true
VERCEL_TEXT_MODEL=openai/gpt-oss-20b
VERCEL_TEXT_FALLBACK_MODELS=meta/llama-3.1-8b-instruct,google/gemini-2.5-flash-lite
VERCEL_MAX_OUTPUT_TOKENS=800
VERCEL_TEMPERATURE=0.2
VERCEL_TIMEOUT_SECONDS=25

# ==================================================
# Groq ZDR - fast fallback, require Zero Data Retention
# ==================================================
GROQ_ENABLED=true
GROQ_REQUIRE_ZERO_DATA_RETENTION=true
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TEXT_FALLBACK_MODELS=llama-3.1-8b-instant,qwen/qwen3-32b,openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=800
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=20

# ==================================================
# Cerebras - no-retention text fallback
# ==================================================
CEREBRAS_ENABLED=true
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TEXT_MODEL=gpt-oss-120b
CEREBRAS_TEXT_FALLBACK_MODELS=zai-glm-4.7,gemma-4-31b
CEREBRAS_MAX_OUTPUT_TOKENS=800
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_TIMEOUT_SECONDS=25

# ==================================================
# Cloudflare Workers AI - serverless text fallback
# ==================================================
CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_TEXT_FALLBACK_MODELS=@cf/meta/llama-3.2-3b-instruct,@cf/openai/gpt-oss-20b,@cf/openai/gpt-oss-120b
CLOUDFLARE_MAX_OUTPUT_TOKENS=800
CLOUDFLARE_TEMPERATURE=0.2
CLOUDFLARE_TIMEOUT_SECONDS=25

# ==================================================
# OpenRouter - strict last fallback / lab
# ==================================================
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_PROVIDER_TRAINING=false
OPENROUTER_ALLOW_PROMPT_LOGGING=false
OPENROUTER_REQUIRE_NO_TRAINING_PROVIDERS=true
OPENROUTER_REQUIRE_NO_LOGGING_PROVIDERS=true
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_TEXT_FALLBACK_MODELS=qwen/qwen3-coder:free
OPENROUTER_FREE_RPM_LIMIT=20
OPENROUTER_FREE_RPD_LIMIT_NO_CREDITS=50
OPENROUTER_FREE_RPD_LIMIT_WITH_10_CREDITS=1000
