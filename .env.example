BD_URL=
BD_HOST=
BD_USER=
BD_PASSWORD=
BD_PORT=
BD_DATABASE=

# Secreto fuerte y único (obligatorio en producción). Generar p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Expiración del token de acceso (default 1d). Ej: 12h, 1d.
JWT_EXPIRATION=1d

# CORS: orígenes del frontend permitidos (coma-separado). Ej en prod:
#   https://mi-frontend.com
# En dev, si se omite, se permiten http://localhost:5173 y http://127.0.0.1:5173
FRONTEND_ORIGIN=

# Form-scan extraction endpoint (POST /purchases/extract)
# Vision provider: "claude" (default) or "gemini" (not implemented yet)
FORM_VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optional: override the Claude vision model (default: claude-haiku-4-5-20251001)
ANTHROPIC_VISION_MODEL=
