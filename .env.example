# Use sslmode=verify-full in PostgreSQL URLs to avoid pg SSL mode warnings.
# Example: postgresql://user:password@host:5432/database?sslmode=verify-full
BD_URL=
BD_HOST=
BD_USER=
BD_PASSWORD=
BD_PORT=
BD_DATABASE=

# Secreto fuerte y único (obligatorio en producción). Generar p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Expiración del token de acceso (default 1d). Ej: 12h, 1d.
JWT_EXPIRATION=1d

# CORS: orígenes del frontend permitidos (coma-separado). Ej en prod:
#   https://mi-frontend.com
# En dev, si se omite, se permiten http://localhost:5173 y http://127.0.0.1:5173
FRONTEND_ORIGIN=

# Form-scan extraction endpoint (POST /purchases/extract)
# Vision provider: "gemini" (default)
FORM_VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the Gemini vision model (default: gemini-3.5-flash)
GEMINI_VISION_MODEL=
# Optional: comma-separated fallback chain used for retryable Gemini failures.
GEMINI_VISION_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
# Optional: override Gemini media resolution for generateContent.
# Default keeps OCR accuracy for receipts/forms.
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
# Operational timeouts, calibrated from backend logs, not fixed by Gemini docs.
# Per-model timeout controls when to try the next fallback model.
GEMINI_TIMEOUT_MS=8000
# Total budget for one extraction request across the full model chain.
GEMINI_TOTAL_TIMEOUT_MS=26000
# Overall endpoint guard. Per-model Gemini limits are enforced by the provider:
# 3.5 Flash 5/20, 3 Flash 5/20, 3.1 Flash-Lite 15/500,
# 2.5 Flash-Lite 10/20, 2.5 Flash 5/20.
GEMINI_EXTRACT_RPM_LIMIT=50
GEMINI_EXTRACT_RPD_LIMIT=618
