# Variables de entorno para el despliegue en Azure
# Copia este archivo a .env.deployment y configura los valores reales


# Configuración de Base de Datos PostgreSQL
BD_HOST=tu_host_postgres
BD_PORT=5432
BD_USER=tu_usuario_postgres
BD_PASSWORD=tu_password_postgres
BD_DATABASE=tu_db_postgres

# Configuración de la aplicación
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Configuración de seguridad (opcional)
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui

# Escaneo de formularios: Gemini principal + fallbacks de proveedor
FORM_VISION_PROVIDER=chain
FORM_VISION_PROVIDER_CHAIN=gemini,ollama,groq,ocrspace
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_VISION_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-flash,gemma-4-31b-it,gemma-4-26b-a4b-it
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
GEMINI_EXTRACT_RPM_LIMIT=50
GEMINI_EXTRACT_RPD_LIMIT=618

# Fallback de visión Groq (o forzar con FORM_VISION_PROVIDER=groq).
# Solo los modelos MULTIMODALES de Groq leen imágenes; los de texto
# (llama-3.3-70b-versatile, llama-3.1-8b-instant) NO sirven aquí.
# qwen/qwen3.6-27b es el default multimodal durable; llama-4-scout también sirve
# pero se apaga el 2026-07-17 (queda solo como fallback temporal — quitarlo luego).
GROQ_API_KEY=tu_api_key_de_groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=8000
GROQ_TOTAL_TIMEOUT_MS=26000

# Fallback de visión Ollama Cloud (o forzar con FORM_VISION_PROVIDER=ollama).
# Requiere OLLAMA_API_KEY. Verifica disponibilidad en https://ollama.com/api/tags
# y usa un modelo multimodal disponible.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=tu_api_key_de_ollama
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_VISION_FALLBACK_MODELS=llama3.2-vision,moondream
OLLAMA_TIMEOUT_MS=15000
OLLAMA_TOTAL_TIMEOUT_MS=45000
OLLAMA_MAX_OUTPUT_TOKENS=2048
OLLAMA_TEMPERATURE=0.1

# Fallback OCR OCR.space (o forzar con FORM_VISION_PROVIDER=ocrspace).
# Fallback externo solo OCR: las imagenes salen del servidor y el backend mapea
# el texto devuelto a campos. Verifica limites actuales del plan gratis.
OCRSPACE_API_KEY=tu_api_key_de_ocrspace
OCRSPACE_BASE_URL=https://api.ocr.space/parse/image
OCRSPACE_LANGUAGE=spa
OCRSPACE_ENGINE=2
OCRSPACE_TIMEOUT_MS=15000

# ==================================================
# Modo privacidad para proveedores futuros de tesis/texto
# ==================================================
# Estas variables definen la postura esperada para cargas sensibles de texto.
# Estan separadas del escaneo de formularios con vision configurado arriba.
PRIVACY_MODE=strict
ALLOW_PROVIDERS_THAT_TRAIN_ON_PROMPTS=false
ALLOW_PROMPT_RETENTION=false
ALLOW_ABUSE_LOG_CONTENT=false
ALLOW_ROUTER_DOWNSTREAM_TRAINING=false

# Orden recomendado para tesis/texto privado. OCR.space es solo vision/OCR.
TEXT_THESIS_PROVIDER_ORDER=gemini,ollama_cloud,groq_zdr,cerebras,cloudflare,vercel_gateway,openrouter

# Proveedores no ideales para privacidad estricta salvo aceptacion explicita.
GEMINI_ENABLED=true
MISTRAL_ENABLED=false
HUGGINGFACE_ENABLED=false

# Gemini texto solo tras confirmar tier pago/no-training/no-retention.
GEMINI_PAID_ALLOWED=true
MISTRAL_SCALE_ALLOWED=false

# ==================================================
# Ollama Cloud - proveedor principal cloud razonable para privacidad
# ==================================================
OLLAMA_CLOUD_ENABLED=true
OLLAMA_CLOUD_API_KEY=tu_api_key_de_ollama
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_TEXT_MODEL=qwen3.6:27b
OLLAMA_CLOUD_TEXT_FALLBACK_MODELS=qwen3.6:35b-a3b,gpt-oss:20b
OLLAMA_CLOUD_TIMEOUT_SECONDS=45
OLLAMA_CLOUD_MAX_OUTPUT_TOKENS=800
OLLAMA_CLOUD_TEMPERATURE=0.2

# ==================================================
# Vercel AI Gateway - capa de gobernanza/routing texto
# ==================================================
VERCEL_AI_GATEWAY_ENABLED=true
VERCEL_AI_GATEWAY_API_KEY=tu_api_key_de_vercel_ai_gateway
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_REQUIRE_ZERO_DATA_RETENTION=true
VERCEL_DISALLOW_PROMPT_TRAINING=true
VERCEL_TEXT_MODEL=openai/gpt-oss-20b
VERCEL_TEXT_FALLBACK_MODELS=meta/llama-3.1-8b-instruct,google/gemini-2.5-flash-lite
VERCEL_MAX_OUTPUT_TOKENS=800
VERCEL_TEMPERATURE=0.2
VERCEL_TIMEOUT_SECONDS=25

# ==================================================
# Groq ZDR - fallback rapido con Zero Data Retention
# ==================================================
GROQ_ENABLED=true
GROQ_REQUIRE_ZERO_DATA_RETENTION=true
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TEXT_FALLBACK_MODELS=llama-3.1-8b-instant,qwen/qwen3-32b,openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=800
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=20

# ==================================================
# Cerebras - fallback sin retencion de contenido
# ==================================================
CEREBRAS_ENABLED=true
CEREBRAS_API_KEY=tu_api_key_de_cerebras
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TEXT_MODEL=gpt-oss-120b
CEREBRAS_TEXT_FALLBACK_MODELS=zai-glm-4.7,gemma-4-31b
CEREBRAS_MAX_OUTPUT_TOKENS=800
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_TIMEOUT_SECONDS=25

# ==================================================
# Cloudflare Workers AI - fallback serverless
# ==================================================
CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_API_TOKEN=tu_token_de_cloudflare
CLOUDFLARE_ACCOUNT_ID=tu_account_id_de_cloudflare
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_TEXT_FALLBACK_MODELS=@cf/meta/llama-3.2-3b-instruct,@cf/openai/gpt-oss-20b,@cf/openai/gpt-oss-120b
CLOUDFLARE_MAX_OUTPUT_TOKENS=800
CLOUDFLARE_TEMPERATURE=0.2
CLOUDFLARE_TIMEOUT_SECONDS=25

# ==================================================
# OpenRouter - ultimo fallback estricto / laboratorio
# ==================================================
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_PROVIDER_TRAINING=false
OPENROUTER_ALLOW_PROMPT_LOGGING=false
OPENROUTER_REQUIRE_NO_TRAINING_PROVIDERS=true
OPENROUTER_REQUIRE_NO_LOGGING_PROVIDERS=true
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_TEXT_FALLBACK_MODELS=qwen/qwen3-coder:free
OPENROUTER_FREE_RPM_LIMIT=20
OPENROUTER_FREE_RPD_LIMIT_NO_CREDITS=50
OPENROUTER_FREE_RPD_LIMIT_WITH_10_CREDITS=1000
