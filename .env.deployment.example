# Variables de entorno para el despliegue en Azure
# Copia este archivo a .env.deployment y configura los valores reales

# Configuración de Azure
RESOURCE_GROUP=rg-inventory-backend
LOCATION=eastus
ENVIRONMENT_NAME=env-inventory-backend
APP_NAME=backend-inventory-app
REGISTRY_NAME=acrinventorybackend
IMAGE_NAME=backend-inventory
TAG=latest

# Configuración de Base de Datos PostgreSQL
BD_HOST=tu_host_postgres
BD_PORT=5432
BD_USER=tu_usuario_postgres
BD_PASSWORD=tu_password_postgres
BD_DATABASE=tu_db_postgres

# Configuración de la aplicación
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Configuración de seguridad (opcional)
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
SSL_CERT_PATH=/home/nodeuser/app/src/certs/DigiCertGlobalRootCA.crt.pem
