{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@loopback/build/config/tsconfig.common.json",
  "ignoreDeprecations": "6.0",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitAny": true,
    "types": [
      "node",
      "mocha",
      "pg"
    ]
  },
  "include": [
    "src"
  ]
}
